<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <PackageId>nntp-client</PackageId>
    <Version>2.0.0</Version>
    <Owners>seanmcelroy</Owners>
    <Authors>Sean McElroy</Authors>
    <Title>nntp-client: Library for interacting with Usenet newsgroups</Title>
    <Description>
      A .NET Core implementation of the NNTP protocol that can be used to create an NNTP
      newsgroup reader client. This repository features a classlib which can be referenced, and a
      small example console application that demonstrates its ability to connect to an NTTP server
      and operate as a client.
    </Description>
    <PackageReleaseNotes>Targeting .NET Core 9 and dropping .NET Standard support.</PackageReleaseNotes>
    <Copyright>Copyright 2025 Sean McElroy</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>NNTP Usenet newsgroup</PackageTags>
    <RepositoryUrl>https://github.com/seanmcelroy/nntp-client</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="log4net" Version="3.1.0" />
  </ItemGroup>
</Project>
